# ==============================================================================
# Balaga API Server Environment Configuration Template
# Copy this file to .env and configure your environment-specific credentials.
# NEVER commit production secrets or service keys to version control!
# ==============================================================================

PORT=5000
NODE_ENV=development

# Authoritative Supabase PostgreSQL Configuration
# Obtain from: Supabase Project Dashboard -> Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://balaga.online
CORS_ORIGIN=https://balaga.online

# Development Mock Auth (Strictly prohibited and ignored in production)
ENABLE_DEV_MOCK_AUTH=false

# Local Development Fallback Persistence Directory
PERSISTENCE_DIR=.data
PERSISTENCE_FILE=.data/platform_storage.json
